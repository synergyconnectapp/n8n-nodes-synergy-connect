{
	"compilerOptions": {
		"strict": true,
		"module": "commonjs",
		"target": "es2022",
		"lib": ["es2022"],
		"declaration": true,
		"moduleResolution": "node",
		"outDir": "./dist",
		"rootDir": ".",
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"forceConsistentCasingInFileNames": true,
		"skipLibCheck": true
	},
	"include": [
		"credentials/**/*.ts",
		"nodes/**/*.ts",
		"nodes/**/*.node.json"
	],
	"exclude": ["node_modules", "dist", "test"]
}
